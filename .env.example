# Copiá este archivo como ".env" y completá los valores.

# Usuario de la modelo en Stripchat: el nombre que aparece en la URL del
# perfil (ej: https://stripchat.com/USUARIO -> USUARIO).
# También podés pegar la URL completa.
STRIPCHAT_MODEL=

# Token del bot que te dio @BotFather (algo como 123456789:AAEhB...)
TELEGRAM_BOT_TOKEN=

# ID del grupo (se obtiene con: python bot.py get-chat-id)
TELEGRAM_CHAT_ID=

# Tu ID de usuario de Telegram (para crear packs de stickers desde el bot).
# Se ve corriendo get-chat-id después de escribirle al bot por privado.
TELEGRAM_USER_ID=

# ------------------------- Opcionales -------------------------------------

# Mensaje de aviso cuando se conecta. Variables disponibles: {model} {show} {url}
# (\n adentro del texto = salto de línea)
MESSAGE_ONLINE=Prendio nuestra Diosa!! 👑👑👑\n👉 {url}

# Enviar un sticker en vez de la foto de la sala: mandale el sticker al bot
# por privado y corré "python bot.py get-sticker-id" para capturar su file_id
STICKER_FILE_ID=

# Avisar también cuando se desconecta (1 = sí, 0 = no). Por defecto: 0
#NOTIFY_OFFLINE=0

# Cada cuántos segundos chequear en modo "loop" (por defecto: 60)
#CHECK_INTERVAL=60

# Mensaje de desconexión. Variables disponibles: {model} {show} {url}
#MESSAGE_OFFLINE=⚫ {model} se desconectó de Stripchat

# Enviar la foto de la sala en vez del sticker (solo si no hay
# STICKER_FILE_ID configurado). Por defecto: 1
#SEND_PHOTO=1

# Contestar el comando /top en el grupo con el top de donadores
# (1 = sí, 0 = no). Por defecto: 1
#TOP_ENABLED=1

# Cuántos puestos mostrar en /top (máximo 10). Por defecto: 10
#TOP_LIMIT=10
